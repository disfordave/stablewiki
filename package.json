    "bcryptjs": "^3.0.2",
    "diff": "^9.0.0",
    "jose": "^6.2.9",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-toc": "^3.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3"
